{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreditReportProbe",
  "version": "1.3.0",
  "description": "解析征信报告并比对期间变动",
  "note": null,
  "input": {
    "type": "object",
    "properties": {
      "subject_id": {
        "type": "string"
      },
      "authorization_id": {
        "type": "string"
      }
    },
    "required": [
      "subject_id",
      "authorization_id"
    ]
  },
  "output": {
    "type": "object",
    "properties": {
      "report": {
        "type": "object"
      },
      "diff": {
        "type": "object"
      },
      "evidence_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^EV-\\d+-\\d{4}$"
        }
      }
    },
    "required": [
      "report",
      "diff",
      "evidence_ids"
    ]
  }
}